<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/soft_white"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang Kembali!"
            android:textSize="25dp"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:layout_marginTop="32dp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="ayo masuk untuk melanjutkan belajar!!"
            android:textSize="15sp"
            android:textColor="@color/dark_text"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/poppins"
            android:paddingStart="5dp"
            android:text="Username"
            android:textColor="@color/dark_text"
            android:textSize="16dp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Anto9080"
            android:background="@drawable/button_line"
            android:paddingStart="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins"
            android:paddingStart="5dp"
            android:text="Email"
            android:textColor="@color/dark_text"
            android:textSize="16dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Anto@gmail.com"
            android:background="@drawable/button_line"
            android:paddingStart="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Password"
            android:textSize="16dp"
            android:textColor="@color/dark_text"
            android:layout_marginTop="15dp"
            android:paddingStart="5dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_line"
            android:hint="********"
            android:fontFamily="@font/poppins"
            android:inputType="textPassword"
            android:paddingStart="16dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Masuk"
            android:textSize="18dp"
            android:fontFamily="@font/poppins"
            android:background="@drawable/button1"
            android:textColor="@android:color/white"
            android:layout_marginTop="20dp"/>

        <!-- 🔥 PEMBAGI "ATAU" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="atau"
            android:textSize="14sp"
            android:textColor="#999999"
            android:fontFamily="@font/poppins"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

        <!-- 🔥 LOGO GOOGLE LINGKARAN (BISA DIPENCET) -->
        <LinearLayout
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/button_google_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_google"
                android:contentDescription="Login dengan Google"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#666666"
            android:fontFamily="@font/poppins"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum punya akun?"
                android:textSize="15sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/dark_text"/>

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Daftar"
                android:textSize="15sp"
                android:textColor="@color/primary_button"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>